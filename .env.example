# Optional overrides. The demo runs with no .env at all -- these are the
# built-in defaults, written out so the wiring is visible.
#
# Every value here is a LOCAL DEVELOPMENT value. There is no provider key, no
# model key, and no token in this demo, and no code path that would read one.

# Dedicated local demo database (docker container `fincore-demo-pg`).
# Port 55433: 55432 is already used by the flagship's own test container.
FINCORE_DEMO_DATABASE_URL=postgresql+psycopg://fincore:fincore@127.0.0.1:55433/fincore_demo

# Schema the flagship migrations are applied into.
FINCORE_DEMO_SCHEMA=demo

# Read-only Financial Operation Core checkout. Defaults to the sibling directory
# ../financial-operation-core-public
# FINCORE_FLAGSHIP_PATH=C:\path\to\financial-operation-core-public

FINCORE_DEMO_HOST=127.0.0.1
FINCORE_DEMO_PORT=8000
